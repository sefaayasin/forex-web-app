# Local market archives and downloader caches; publish only research reports
# and the small reference files the live app needs to score new bars.
data/historical*/
data/news/*
!data/news/fomc_statements.csv
data/ml/*_oos.csv
data/ml/tournament/*.joblib
# The ML page scores every pair, so the deployed app needs every pair's model.
# Direction models are ~1 MB each (~28 MB total); volatility models ~8 KB each.
!data/ml/tournament/*_direction_research.joblib
!data/ml/tournament/*_high_volatility_research.joblib
data/ml/tournament/final_predictions.csv.gz
data/ml/tournament_rebuilt/final_predictions.csv.gz
data/ml/tournament_rebuilt/*.joblib
research/meta_label/dataset.csv.gz
research/spreads/cache/
tick_downloader/node_modules/
tick_downloader/cache/
research/feed_calls/rows/
research/feed_calls/yahoo_cache/
research/levels/trades/
research/calendar_sources/raw/
research/freshness/rows/
